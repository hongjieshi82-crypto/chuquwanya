# Copy to deploy/production.env on the ECS server. Never commit the real file.
PORT=3001
CLIENT_ORIGIN=https://hongjieshi82-crypto.github.io

# MySQL. DB_HOST must match the Compose service name.
DB_HOST=mysql
DB_PORT=3306
DB_USER=chuqu_app
DB_PASSWORD=replace_with_a_long_random_password
DB_NAME=chuquwanya
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
MYSQL_DATABASE=chuquwanya
MYSQL_USER=chuqu_app
MYSQL_PASSWORD=replace_with_a_long_random_password

# Runtime security.
JWT_SECRET=replace_with_at_least_32_random_characters
LOG_LEVEL=info
API_STARTUP_MIGRATIONS=true
DB_MIGRATION_MAX_ATTEMPTS=12

# Real AI provider. One SiliconFlow key can serve LLM and embeddings.
AI_LLM_PROVIDER=siliconflow
AI_EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=replace_with_your_siliconflow_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_LLM_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=1024

# Map/geocoding. The app remains usable without this key, but distance checks degrade.
AMAP_WEB_SERVICE_KEY=replace_with_your_amap_web_service_key

# Optional vector recall. SQL recall remains available when Chroma is offline.
CHROMA_URL=http://chroma:8000
CHROMA_ACTIVITY_COLLECTION=activity_cards

# Optional Qdrant-powered travel APIs. Configure Qdrant Cloud later if needed.
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# Keep non-core capabilities disabled for the portfolio release.
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
ALIPAY_ENV=sandbox
